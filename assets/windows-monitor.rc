#pragma code_page(65001)

101 ICON "@ICON_PATH@"
1 24 "@MANIFEST_PATH@"

1 VERSIONINFO
FILEVERSION @VERSION_FIELDS@
PRODUCTVERSION @VERSION_FIELDS@
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "@PRODUCT_NAME@"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "@PRODUCT_NAME@"
            VALUE "OriginalFilename", "@PRODUCT_NAME@.exe"
            VALUE "ProductName", "@PRODUCT_NAME@"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
